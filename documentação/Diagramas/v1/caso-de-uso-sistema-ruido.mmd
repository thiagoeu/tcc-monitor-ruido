  UC_MON -- "<<include>>" --> UC_CMP

  UC_ALT -- "<<extend>>" --> UC_CMP
  UC_ALT -- "<<include>>" --> UC_LED
  UC_ALT -- "<<include>>" --> UC_WEB

  UC_CON -- "<<include>>" --> UC_MON
  UC_RES -- "<<include>>" --> UC_CON
  UC_TXT -- "<<include>>" --> UC_RES

  N1["Sem mock: a medicao vem do\nsensor E06A fisico via RS485."]
  N2["Fluxo de excecao:\nquando dB > limite do ambiente,\no sistema registra alerta e\naciona indicacao local/remota."]

  UC_RX -.-> N1
