flowchart LR
  %% Caso de Uso - Sistema de Monitoramento de Ruido (Operacao Real)

  G["Gerenciador"]
  S["Sensor E06A (Real)"]
  R["Interface RS485"]
  L["Sinalizacao LED/LCD"]

  subgraph SYS["Sistema de Monitoramento de Ruido<br/>(Backend + Dashboard no Raspberry Pi)"]
    UC_CAD([Cadastrar ambiente])
    UC_EDT([Editar ambiente])
    UC_DEL([Remover ambiente])
    UC_ATV([Ativar/Desativar ambiente])

    UC_MON([Monitorar ruido em tempo real])
    UC_RX([Receber medicao de sensor real])
    UC_VAL(["Validar integridade da leitura<br/>(checksum/protocolo)"])
    UC_REG([Registrar medicao])
    UC_CMP(["Comparar leitura com<br/>limite configurado"])

    UC_ALT([Gerar alerta de excesso de ruido])
    UC_LED(["Acionar indicacao fisica<br/>(LED/LCD)"])
    UC_WEB(["Exibir alerta visual<br/>no dashboard"])

    UC_CON(["Consultar monitoramento<br/>e alertas recentes"])
    UC_RES([Gerar resumo estatistico])
    UC_TXT([Baixar relatorio TXT])
  end

  G --> UC_CAD
  G --> UC_EDT
  G --> UC_DEL
  G --> UC_ATV
  G --> UC_MON
  G --> UC_CON
  G --> UC_RES
  G --> UC_TXT

  S --> UC_RX
  R --> UC_RX
  L --> UC_LED

  UC_MON -- "<<include>>" --> UC_RX
